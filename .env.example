# -------------------------------------------------------------
# Slack App Authentication
# -------------------------------------------------------------
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing Secret for verifying requests from Slack
SLACK_SIGNING_SECRET=your-signing-secret
# App-Level Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token
# Socket Mode switch ('true' for local testing without ngrok, 'false' for Cloud Run production)
SLACK_SOCKET_MODE=false

# -------------------------------------------------------------
# Google Cloud / Google Sheets API Authentication
# -------------------------------------------------------------
# Service Account client email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
# Service Account private key (preserve newlines or use escaped \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Target Spreadsheet ID (found in URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your-google-spreadsheet-id

# -------------------------------------------------------------
# Google AI Studio / Gemini API (Free Tier)
# -------------------------------------------------------------
# API Key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
# Model endpoint name (e.g. gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# Reminder & Notification Settings
# -------------------------------------------------------------
# Channel ID where reminder broadcast will be sent (e.g. C0123456789)
SLACK_NOTIFICATION_CHANNEL_ID=C0123456789
# JSON mapping of normalized Japanese names to Slack User IDs
MEMBER_SLACK_MAPPING={"大沼佑磨": "U0123456789"}
# Secret token to protect the Cloud Scheduler reminder endpoint (/api/reminder)
REMINDER_SECRET_TOKEN=generate-a-random-secret-token-here
# Whether to send direct DM reminders to unsubmitted members (true/false)
ENABLE_DM_REMINDERS=false

# -------------------------------------------------------------
# Server Port
# -------------------------------------------------------------
PORT=3000
