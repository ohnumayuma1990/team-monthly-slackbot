# -------------------------------------------------------------
# Slack App Authentication
# -------------------------------------------------------------
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing Secret for verifying requests from Slack
SLACK_SIGNING_SECRET=your-signing-secret
# App-Level Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token
# Socket Mode switch ('true' for local testing without ngrok, 'false' for Cloud Run production)
SLACK_SOCKET_MODE=false

# -------------------------------------------------------------
# Google Cloud / Google Sheets API Authentication
# -------------------------------------------------------------
# Service Account client email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
# Service Account private key (preserve newlines or use escaped \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Target Spreadsheet ID (found in URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your-google-spreadsheet-id

# -------------------------------------------------------------
# Google AI Studio / Gemini API (Free Tier)
# -------------------------------------------------------------
# API Key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
# Model endpoint name (e.g. gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# Team Member & Manager Configuration (JSON)
# -------------------------------------------------------------
# Centralized JSON array for all team members and manager.
# Managing members here applies to weekly checks, attendance, emails, and spreadsheet reminders.
TEAM_MEMBERS_CONFIG=[{"name":"山田 太郎","slackId":"U0123456789","email":"yamada@example.com","staffNum":"000101","role":"member"},{"name":"佐藤 花子","slackId":"U0987654321","email":"sato@example.com","staffNum":"000102","role":"manager"}]

# -------------------------------------------------------------
# Email Filtering & Routing Settings
# -------------------------------------------------------------
# Comma-separated list of sender emails to report directly to manager DM (e.g. executive reports)
MANAGER_REPORT_FROM_EMAILS=executive@example.com
# Comma-separated list of subject keywords to report directly to manager DM
MANAGER_REPORT_KEYWORDS=manager-keyword1,manager-keyword2
# Comma-separated list of recipient emails to exclude from announcement notifications
EXCLUDE_ANNOUNCEMENT_TO_EMAILS=exclude@example.com
# Comma-separated list of subject keywords for all-hands announcements
ANNOUNCEMENT_KEYWORDS=allpe
# Comma-separated list of subject keywords for attendance emails
ATTENDANCE_KEYWORDS=applies

# -------------------------------------------------------------
# Reminder & Notification Settings
# -------------------------------------------------------------
# Channel ID where reminder broadcast will be sent (e.g. C0123456789)
SLACK_NOTIFICATION_CHANNEL_ID=C0123456789
# Manager Slack user ID (fallback if not defined in TEAM_MEMBERS_CONFIG)
MANAGER_SLACK_USER_ID=U0987654321
# Secret token to protect the Cloud Scheduler reminder endpoint (/api/reminder)
REMINDER_SECRET_TOKEN=generate-a-random-secret-token-here
# Whether to send direct DM reminders to unsubmitted members (true/false)
ENABLE_DM_REMINDERS=false

# -------------------------------------------------------------
# Server Port
# -------------------------------------------------------------
PORT=3000
